+/// An aligned grid of equal-width stat tiles. Column count follows the width
+/// it is given (never scrolls sideways), so a card reads the same on a phone,
+/// an iPad and a desktop window.
+class _StatGrid extends StatelessWidget {
+  final List<Widget> tiles;
+  const _StatGrid(this.tiles);
+
+  static const double _minTile = 76;
+  static const double _gap = 6;
+
+  @override
+  Widget build(BuildContext context) {
+    return LayoutBuilder(builder: (context, c) {
+      final w = c.maxWidth;
+      final cols = ((w + _gap) / (_minTile + _gap)).floor().clamp(2, 12);
+      final tileW = (w - _gap * (cols - 1)) / cols;
+      return Wrap(
+        spacing: _gap,
+        runSpacing: _gap,
+        children: [for (final t in tiles) SizedBox(width: tileW, child: t)],
+      );
+    });
+  }
 }
 
