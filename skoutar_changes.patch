+        final ar = after.putIfAbsent(a, () => AfterPitchRow(a));
+        ar.next.add(pa[i]);
+        ar.nextTypes[bT] = (ar.nextTypes[bT] ?? 0) + 1;
+        final tr = trans.putIfAbsent('$a>$bT', () => TransitionRow(a, bT));
+        tr.results.add(pa[i]);
+        if (done && i == pa.length - 1) tr.paEnd.addOutcome(pa[i].outcome);
+      }
